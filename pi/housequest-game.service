[Unit]
Description=HouseQuest game service (tasks/claims)
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/housequest/game.py
Environment=HOUSEQUEST_DB=/var/lib/housequest/game.db
# Same MQTT login as the kiosk
LoadCredential=mqtt.json:/etc/housequest/kiosk.json
DynamicUser=yes
StateDirectory=housequest
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
